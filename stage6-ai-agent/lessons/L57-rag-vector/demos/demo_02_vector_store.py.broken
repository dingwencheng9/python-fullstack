"""Demo 02: Qdrant 2026 异步检索实战

本演示展示如何使用 AsyncQdrantClient 进行向量存储和检索操作。
重点演示 2026 年新版 API：query_points() 替代旧版 search()。

核心要点：
1. 使用 AsyncQdrantClient（全异步，不阻塞事件循环）
2. 动态维度集合创建
3. 使用 query_points() 进行语义检索
4. 强类型防线：list[ScoredPoint] 类型签名

运行方式：
    python demo_02_vector_store.py
"""

import asyncio
import sys
from pathlib import Path
from typing import Any

# 添加 core 模块到路径
sys.path.insert(0, str(Path(__file__).parent.parent.parent.parent))

from qdrant_client import AsyncQdrantClient
from qdrant_client.models import (
    Distance,
    PointStruct,
    ScoredPoint,
    VectorParams,
)


async def demo_memory_mode() -> None:
    """演示内存模式（开发/测试环境）"""
    print("=" * 60)
    print("Demo 2.1: 内存模式向量存储")
    print("=" * 60)

    # 创建内存模式客户端
    client = AsyncQdrantClient(":memory:")
    print("✅ AsyncQdrantClient 已创建（内存模式）")

    try:
        # 创建集合（动态维度：384 维）
        collection_name = "demo_docs"
        vector_size = 384  # 假设使用 nomic-embed-text 模型

        await client.recreate_collection(
            collection_name=collection_name,
            vectors_config=VectorParams(
                size=vector_size,
                distance=Distance.COSINE,  # 余弦相似度
            ),
        )
        print(f"✅ 集合已创建: {collection_name} (维度: {vector_size})")

        # 准备示例数据（模拟 embedding）
        import random

        def mock_embedding(text: str) -> list[float]:
            """模拟 embedding 生成（实际应使用真实模型）"""
            random.seed(hash(text))
            return [random.random() for _ in range(vector_size)]

        # 插入向量数据
        documents = [
            "Python 是一种高级编程语言",
            "FastAPI 是一个现代化的 Web 框架",
            "Qdrant 是一个向量数据库",
            "异步编程可以提高性能",
        ]

        points = [
            PointStruct(
                id=i,
                vector=mock_embedding(doc),
                payload={"text": doc, "source": "demo", "index": i},
            )
            for i, doc in enumerate(documents)
        ]

        await client.upsert(
            collection_name=collection_name,
            points=points,
        )
        print(f"✅ 已插入 {len(points)} 条向量数据")

        # 使用 query_points() 进行检索（2026 新版 API）
        query_text = "什么是 Python？"
        query_vector = mock_embedding(query_text)

        results: list[ScoredPoint] = results_response = await client.query_points(
            collection_name=collection_name,
        results: list[ScoredPoint] = results_response.points
            query=query_vector,  # 新版使用 query 参数
            limit=2,
        ).points  # 注意：返回 QueryResponse，需要 .points 获取结果

        print(f"\n🔍 查询: {query_text}")
        print(f"✅ 检索到 {len(results)} 条结果:")
        for i, hit in enumerate(results, 1):
            # 类型安全：ScoredPoint 有明确的类型签名
            text: str = hit.payload.get("text", "")  # type: ignore
            score: float = hit.score if hit.score is not None else 0.0
            print(f"  {i}. [得分: {score:.4f}] {text}")

    finally:
        await client.close()
        print("\n✅ 客户端已关闭")


async def demo_docker_mode() -> None:
    """演示 Docker 模式（生产环境）"""
    print("\n" + "=" * 60)
    print("Demo 2.2: Docker 模式连接（生产环境）")
    print("=" * 60)

    print("⚠️  需要先启动 Qdrant Docker 容器:")
    print("    docker run -p 6333:6333 qdrant/qdrant")
    print()

    # 尝试连接 Docker 模式
    try:
        client = AsyncQdrantClient(host="localhost", port=6333)
        print("✅ 尝试连接 Qdrant (localhost:6333)...")

        # 获取集合列表
        collections = await client.get_collections()
        print(f"✅ 连接成功！当前集合数量: {len(collections.collections)}")

        # 列出所有集合
        for collection in collections.collections:
            print(f"  - {collection.name}")

        await client.close()

    except Exception as e:
        print(f"❌ 连接失败: {type(e).__name__}: {e}")
        print("💡 提示: 确保 Qdrant 容器正在运行")


async def demo_dynamic_dimension() -> None:
    """演示动态维度集合创建"""
    print("\n" + "=" * 60)
    print("Demo 2.3: 动态维度集合创建")
    print("=" * 60)

    client = AsyncQdrantClient(":memory:")

    try:
        # 模拟不同 embedding 模型的维度
        embedding_models = {
            "nomic-embed-text": 384,
            "text-embedding-3-small": 1536,
            "text-embedding-3-large": 3072,
        }

        for model_name, dimension in embedding_models.items():
            collection_name = f"collection_{model_name.replace('-', '_')}"

            await client.recreate_collection(
                collection_name=collection_name,
                vectors_config=VectorParams(
                    size=dimension,
                    distance=Distance.COSINE,
                ),
            )
            print(f"✅ 集合 {collection_name} 已创建 (维度: {dimension})")

        # 列出所有集合
        collections = await client.get_collections()
        print(f"\n✅ 总共创建了 {len(collections.collections)} 个集合")

    finally:
        await client.close()


async def demo_type_safety() -> None:
    """演示强类型防线"""
    print("\n" + "=" * 60)
    print("Demo 2.4: 强类型防线演示")
    print("=" * 60)

    client = AsyncQdrantClient(":memory:")

    try:
        # 创建集合
        collection_name = "type_safe_demo"
        await client.recreate_collection(
            collection_name=collection_name,
            vectors_config=VectorParams(size=128, distance=Distance.COSINE),
        )

        # 插入数据
        points = [
            PointStruct(
                id=1,
                vector=[0.1] * 128,
                payload={"text": "示例文本", "score_value": 0.95},
            )
        ]
        await client.upsert(collection_name=collection_name, points=points)

        # 检索（强类型）
        results: list[ScoredPoint] = results_response = await client.query_points(
            collection_name=collection_name,
            query=[0.1] * 128,
            limit=1,
        )

        # 类型缩窄（Type Narrowing）
        for hit in results:
            # 检查 score 是否为 None（类型安全）
            if hit.score is not None:
                score: float = hit.score
                print(f"✅ 得分（类型安全）: {score:.4f}")
            else:
                print("⚠️  得分为 None")

            # 检查 payload
            if hit.payload:
                payload: dict[str, Any] = hit.payload
                text: str | None = payload.get("text")
                if isinstance(text, str):
                    print(f"✅ 文本（类型安全）: {text}")

        print("\n✅ 类型安全检查通过（mypy --strict）")

    finally:
        await client.close()


async def demo_batch_operations() -> None:
    """演示批量操作"""
    print("\n" + "=" * 60)
    print("Demo 2.5: 批量操作优化")
    print("=" * 60)

    client = AsyncQdrantClient(":memory:")

    try:
        collection_name = "batch_demo"
        vector_size = 128

        await client.recreate_collection(
            collection_name=collection_name,
            vectors_config=VectorParams(size=vector_size, distance=Distance.COSINE),
        )

        # 批量插入（模拟大量数据）
        batch_size = 100
        print(f"⏳ 正在批量插入 {batch_size} 条数据...")

        import random

        points = [
            PointStruct(
                id=i,
                vector=[random.random() for _ in range(vector_size)],
                payload={"text": f"文档 {i}", "batch": i // 10},
            )
            for i in range(batch_size)
        ]

        await client.upsert(collection_name=collection_name, points=points)
        print("✅ 批量插入完成")

        # 批量检索
        query_vector = [random.random() for _ in range(vector_size)]
        results: list[ScoredPoint] = results_response = await client.query_points(
            collection_name=collection_name,
            query=query_vector,
            limit=5,
        ))

        print(f"✅ 批量检索完成，返回 Top-{len(results)} 结果")

    finally:
        await client.close()


async def main() -> None:
    """主函数：运行所有演示"""
    print("\n" + "🚀" * 30)
    print("L17 Demo 02: Qdrant 2026 异步检索实战")
    print("🚀" * 30 + "\n")

    # 运行所有演示
    await demo_memory_mode()
    await demo_docker_mode()
    await demo_dynamic_dimension()
    await demo_type_safety()
    await demo_batch_operations()

    print("\n" + "✅" * 30)
    print("所有演示完成！")
    print("✅" * 30 + "\n")

    # 关键学习点总结
    print("📚 关键学习点:")
    print("=" * 60)
    print("1. ✅ 使用 AsyncQdrantClient（全异步，不阻塞）")
    print("2. ✅ query_points() 替代旧版 search()（2026 新版 API）")
    print("3. ✅ 动态维度集合创建（支持不同 embedding 模型）")
    print("4. ✅ 强类型防线：list[ScoredPoint] + 类型缩窄")
    print("5. ✅ 批量操作优化（提高性能）")
    print("=" * 60)

    print("\n💡 下一步:")
    print("   - 运行 demo_03: 混合元数据过滤与语义检索")
    print("   - 运行 demo_04: 完整的 RAG 流水线闭环")


if __name__ == "__main__":
    # 运行异步主函数
    try:
        asyncio.run(main())
    except KeyboardInterrupt:
        print("\n\n⚠️  程序被用户中断")
    except Exception as e:
        print(f"\n\n❌ 未捕获的异常: {type(e).__name__}: {e}")
        raise
