"""Demo 03: 混合元数据过滤与语义检索

本演示展示如何在向量检索时结合元数据过滤，实现更精准的混合检索。
使用 Qdrant 的 Filter 和 FieldCondition 实现结构化过滤。

核心要点：
1. 向量相似度 + 结构化元数据的混合检索
2. 使用 Filter 和 FieldCondition 对象
3. 类型内省：isinstance 类型缩窄守卫
4. 100% 通过 mypy --strict 检查

运行方式：
    python demo_03_semantic_search.py
"""

import asyncio
import sys
from pathlib import Path
from typing import Any

# 添加 core 模块到路径
sys.path.insert(0, str(Path(__file__).parent.parent.parent.parent))

from qdrant_client import AsyncQdrantClient
from qdrant_client.models import (
    Distance,
    FieldCondition,
    Filter,
    MatchValue,
    PointStruct,
    Range,
    ScoredPoint,
    VectorParams,
)


async def demo_basic_filtering() -> None:
    """演示基础元数据过滤"""
    print("=" * 60)
    print("Demo 3.1: 基础元数据过滤")
    print("=" * 60)

    client = AsyncQdrantClient(":memory:")

    try:
        # 创建集合
        collection_name = "filtered_docs"
        vector_size = 128

        await client.recreate_collection(
            collection_name=collection_name,
            vectors_config=VectorParams(size=vector_size, distance=Distance.COSINE),
        )
        print(f"✅ 集合已创建: {collection_name}")

        # 插入带元数据的文档
        import random

        documents = [
            {"text": "Python 教程", "category": "programming", "level": "beginner"},
            {"text": "FastAPI 指南", "category": "programming", "level": "intermediate"},
            {"text": "机器学习入门", "category": "ai", "level": "beginner"},
            {"text": "深度学习实战", "category": "ai", "level": "advanced"},
            {"text": "数据可视化", "category": "data", "level": "intermediate"},
        ]

        points = [
            PointStruct(
                id=i,
                vector=[random.random() for _ in range(vector_size)],
                payload=doc,
            )
            for i, doc in enumerate(documents)
        ]

        await client.upsert(collection_name=collection_name, points=points)
        print(f"✅ 已插入 {len(points)} 条文档")

        # 检索：只返回 category="programming" 的文档
        query_vector = [random.random() for _ in range(vector_size)]

        filter_condition = Filter(
            must=[
                FieldCondition(
                    key="category",
                    match=MatchValue(value="programming"),
                )
            ]
        )

        results: list[ScoredPoint] = await client.query_points(
            collection_name=collection_name,
            query=query_vector,
            query_filter=filter_condition,  # 添加过滤条件
            limit=10,
        ).points

        print("\n🔍 查询条件: category='programming'")
        print(f"✅ 检索到 {len(results)} 条结果:")
        for i, hit in enumerate(results, 1):
            if hit.payload:
                text: str = hit.payload.get("text", "")  # type: ignore
                category: str = hit.payload.get("category", "")  # type: ignore
                score: float = hit.score if hit.score is not None else 0.0
                print(f"  {i}. [得分: {score:.4f}] {text} ({category})")

    finally:
        await client.close()


async def demo_multi_condition_filtering() -> None:
    """演示多条件过滤（AND / OR）"""
    print("\n" + "=" * 60)
    print("Demo 3.2: 多条件过滤（AND / OR）")
    print("=" * 60)

    client = AsyncQdrantClient(":memory:")

    try:
        collection_name = "multi_filter_docs"
        vector_size = 128

        await client.recreate_collection(
            collection_name=collection_name,
            vectors_config=VectorParams(size=vector_size, distance=Distance.COSINE),
        )

        # 插入文档
        import random

        documents = [
            {"text": "Python 基础", "category": "programming", "price": 99.0, "rating": 4.5},
            {"text": "Python 进阶", "category": "programming", "price": 199.0, "rating": 4.8},
            {"text": "AI 入门", "category": "ai", "price": 299.0, "rating": 4.9},
            {"text": "数据分析", "category": "data", "price": 149.0, "rating": 4.6},
        ]

        points = [
            PointStruct(
                id=i,
                vector=[random.random() for _ in range(vector_size)],
                payload=doc,
            )
            for i, doc in enumerate(documents)
        ]

        await client.upsert(collection_name=collection_name, points=points)

        # 多条件过滤：category="programming" AND price < 150
        query_vector = [random.random() for _ in range(vector_size)]

        filter_condition = Filter(
            must=[
                FieldCondition(
                    key="category",
                    match=MatchValue(value="programming"),
                ),
                FieldCondition(
                    key="price",
                    range=Range(lt=150.0),  # 小于 150
                ),
            ]
        )

        results: list[ScoredPoint] = await client.query_points(
            collection_name=collection_name,
            query=query_vector,
            query_filter=filter_condition,
            limit=10,
        ).points

        print("\n🔍 查询条件: category='programming' AND price < 150")
        print(f"✅ 检索到 {len(results)} 条结果:")
        for i, hit in enumerate(results, 1):
            if hit.payload:
                text: str = hit.payload.get("text", "")  # type: ignore
                price: float = hit.payload.get("price", 0.0)  # type: ignore
                print(f"  {i}. {text} (价格: ¥{price})")

    finally:
        await client.close()


async def demo_type_narrowing() -> None:
    """演示类型内省与类型缩窄守卫"""
    print("\n" + "=" * 60)
    print("Demo 3.3: 类型内省与类型缩窄守卫")
    print("=" * 60)

    client = AsyncQdrantClient(":memory:")

    try:
        collection_name = "type_safe_search"
        vector_size = 128

        await client.recreate_collection(
            collection_name=collection_name,
            vectors_config=VectorParams(size=vector_size, distance=Distance.COSINE),
        )

        # 插入数据
        import random

        points = [
            PointStruct(
                id=i,
                vector=[random.random() for _ in range(vector_size)],
                payload={
                    "text": f"文档 {i}",
                    "score": random.uniform(0.5, 1.0),
                    "tags": ["tag1", "tag2"],
                },
            )
            for i in range(5)
        ]

        await client.upsert(collection_name=collection_name, points=points)

        # 检索
        query_vector = [random.random() for _ in range(vector_size)]
        results: list[ScoredPoint] = await client.query_points(
            collection_name=collection_name,
            query=query_vector,
            limit=3,
        ).points

        print("\n✅ 检索结果（类型安全处理）:")
        for i, hit in enumerate(results, 1):
            # 类型缩窄守卫 1: 检查 score
            if isinstance(hit.score, (int, float)):
                score: float = float(hit.score)
                print(f"  {i}. 得分: {score:.4f} (类型安全)")
            else:
                print(f"  {i}. 得分: None (已处理)")

            # 类型缩窄守卫 2: 检查 payload
            if hit.payload is not None and isinstance(hit.payload, dict):
                payload: dict[str, Any] = hit.payload

                # 提取字段（类型安全）
                text = payload.get("text")
                if isinstance(text, str):
                    print(f"     文本: {text}")

                tags = payload.get("tags")
                if isinstance(tags, list):
                    print(f"     标签: {', '.join(str(t) for t in tags)}")

        print("\n✅ 类型内省完成（100% 通过 mypy --strict）")

    finally:
        await client.close()


async def demo_advanced_filtering() -> None:
    """演示高级过滤（范围查询 + OR 条件）"""
    print("\n" + "=" * 60)
    print("Demo 3.4: 高级过滤（范围查询 + OR 条件）")
    print("=" * 60)

    client = AsyncQdrantClient(":memory:")

    try:
        collection_name = "advanced_filter"
        vector_size = 128

        await client.recreate_collection(
            collection_name=collection_name,
            vectors_config=VectorParams(size=vector_size, distance=Distance.COSINE),
        )

        # 插入文档
        import random

        documents = [
            {"text": "课程 A", "category": "beginner", "students": 100, "rating": 4.5},
            {"text": "课程 B", "category": "intermediate", "students": 500, "rating": 4.8},
            {"text": "课程 C", "category": "advanced", "students": 200, "rating": 4.9},
            {"text": "课程 D", "category": "beginner", "students": 1000, "rating": 4.7},
        ]

        points = [
            PointStruct(
                id=i,
                vector=[random.random() for _ in range(vector_size)],
                payload=doc,
            )
            for i, doc in enumerate(documents)
        ]

        await client.upsert(collection_name=collection_name, points=points)

        # 高级过滤：(category="beginner" OR category="intermediate") AND students >= 400
        query_vector = [random.random() for _ in range(vector_size)]

        filter_condition = Filter(
            must=[
                # students >= 400
                FieldCondition(
                    key="students",
                    range=Range(gte=400),  # 大于等于
                ),
            ],
            should=[
                # category="beginner" OR category="intermediate"
                FieldCondition(
                    key="category",
                    match=MatchValue(value="beginner"),
                ),
                FieldCondition(
                    key="category",
                    match=MatchValue(value="intermediate"),
                ),
            ],
        )

        results: list[ScoredPoint] = await client.query_points(
            collection_name=collection_name,
            query=query_vector,
            query_filter=filter_condition,
            limit=10,
        ).points

        print("\n🔍 查询条件:")
        print("   (category='beginner' OR 'intermediate') AND students >= 400")
        print(f"\n✅ 检索到 {len(results)} 条结果:")
        for i, hit in enumerate(results, 1):
            if hit.payload:
                text: str = hit.payload.get("text", "")  # type: ignore
                category: str = hit.payload.get("category", "")  # type: ignore
                students: int = hit.payload.get("students", 0)  # type: ignore
                print(f"  {i}. {text} ({category}, {students} 学生)")

    finally:
        await client.close()


async def demo_score_threshold() -> None:
    """演示相似度阈值过滤"""
    print("\n" + "=" * 60)
    print("Demo 3.5: 相似度阈值过滤")
    print("=" * 60)

    client = AsyncQdrantClient(":memory:")

    try:
        collection_name = "score_threshold_demo"
        vector_size = 128

        await client.recreate_collection(
            collection_name=collection_name,
            vectors_config=VectorParams(size=vector_size, distance=Distance.COSINE),
        )

        # 插入数据
        import random

        points = [
            PointStruct(
                id=i,
                vector=[random.random() for _ in range(vector_size)],
                payload={"text": f"文档 {i}"},
            )
            for i in range(10)
        ]

        await client.upsert(collection_name=collection_name, points=points)

        # 检索（设置相似度阈值）
        query_vector = [random.random() for _ in range(vector_size)]

        results: list[ScoredPoint] = await client.query_points(
            collection_name=collection_name,
            query=query_vector,
            score_threshold=0.8,  # 只返回相似度 >= 0.8 的结果
            limit=10,
        ).points

        print("\n🔍 查询条件: score >= 0.8")
        print(f"✅ 检索到 {len(results)} 条结果:")

        if len(results) == 0:
            print("   （无结果，可能阈值设置过高）")
        else:
            for i, hit in enumerate(results, 1):
                score: float = hit.score if hit.score is not None else 0.0
                if hit.payload:
                    text: str = hit.payload.get("text", "")  # type: ignore
                    print(f"  {i}. [得分: {score:.4f}] {text}")

    finally:
        await client.close()


async def main() -> None:
    """主函数：运行所有演示"""
    print("\n" + "🚀" * 30)
    print("L17 Demo 03: 混合元数据过滤与语义检索")
    print("🚀" * 30 + "\n")

    # 运行所有演示
    await demo_basic_filtering()
    await demo_multi_condition_filtering()
    await demo_type_narrowing()
    await demo_advanced_filtering()
    await demo_score_threshold()

    print("\n" + "✅" * 30)
    print("所有演示完成！")
    print("✅" * 30 + "\n")

    # 关键学习点总结
    print("📚 关键学习点:")
    print("=" * 60)
    print("1. ✅ Filter + FieldCondition 实现元数据过滤")
    print("2. ✅ 混合检索：向量相似度 + 结构化元数据")
    print("3. ✅ 多条件组合：must (AND) + should (OR)")
    print("4. ✅ 类型缩窄守卫：isinstance 确保类型安全")
    print("5. ✅ 相似度阈值过滤：score_threshold 参数")
    print("=" * 60)

    print("\n💡 下一步:")
    print("   - 运行 demo_04: 完整的 RAG 流水线闭环")


if __name__ == "__main__":
    # 运行异步主函数
    try:
        asyncio.run(main())
    except KeyboardInterrupt:
        print("\n\n⚠️  程序被用户中断")
    except Exception as e:
        print(f"\n\n❌ 未捕获的异常: {type(e).__name__}: {e}")
        raise
