# ============================================================
# 环境变量配置模板
# ============================================================
# 使用方法:
#   1. 复制此文件为 .env: cp .env.example .env
#   2. 填写实际的敏感信息
#   3. .env 文件已被 .gitignore 排除，不会提交到 Git
#
# 注意:
#   - 生产环境必须修改所有默认密码
#   - API Key 等敏感信息不要硬编码在代码中
#   - 不同环境使用不同的 .env 文件
# ============================================================

# ─────────────────────────────────────────────────────────
# 应用基础配置
# ─────────────────────────────────────────────────────────

# 运行环境: development | staging | production
ENVIRONMENT=development

# 调试模式（生产环境必须设置为 false）
DEBUG=true

# 日志级别: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ─────────────────────────────────────────────────────────
# 数据库配置
# ─────────────────────────────────────────────────────────

# PostgreSQL 配置
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=agent_db

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ─────────────────────────────────────────────────────────
# LLM API 配置
# ─────────────────────────────────────────────────────────

# LLM API Key（必须设置）
# 旧变量名支持: TENCENT_MAAS_API_KEY
LLM_API_KEY=

# LLM API Base URL
LLM_API_BASE_URL=https://tokenhub.tencentmaas.com/v1

# 默认模型
LLM_MODEL=glm-5.2

# 最大输出 Token 数
LLM_MAX_TOKENS=8192

# 温度参数 (0.0 - 2.0)
LLM_TEMPERATURE=0.1

# API 超时时间（秒）
LLM_TIMEOUT=120

# ─────────────────────────────────────────────────────────
# Ollama 本地模型配置
# ─────────────────────────────────────────────────────────

# Ollama 服务地址
OLLAMA_URL=http://localhost:11434

# Ollama 默认模型
OLLAMA_MODEL=deepseek-r1:latest

# ─────────────────────────────────────────────────────────
# OpenAI 配置
# ─────────────────────────────────────────────────────────

# OpenAI API Key（与 LLM_API_KEY 二选一）
OPENAI_API_KEY=

# OpenAI 默认模型
OPENAI_MODEL=gpt-4o-mini

# ─────────────────────────────────────────────────────────
# 向量数据库配置 (Qdrant)
# ─────────────────────────────────────────────────────────

# Qdrant 主机地址
QDRANT_HOST=localhost

# Qdrant 端口
QDRANT_PORT=6333

# Qdrant API Key（可选）
QDRANT_API_KEY=

# ─────────────────────────────────────────────────────────
# Uvicorn 服务器配置
# ─────────────────────────────────────────────────────────

# 绑定地址（0.0.0.0 允许外部访问，127.0.0.1 仅本地访问）
UVICORN_HOST=127.0.0.1

# 绑定端口
UVICORN_PORT=8000

# 热重载（仅开发环境）
UVICORN_RELOAD=false

# ─────────────────────────────────────────────────────────
# 可观测性配置
# ─────────────────────────────────────────────────────────

# OpenTelemetry OTLP Exporter 端点
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# 服务名称
OTEL_SERVICE_NAME=python-fullstack-course

# Prometheus 端口
PROMETHEUS_PORT=9090

# Jaeger UI 端口
JAEGER_UI_PORT=16686

# Grafana 管理员账号（生产环境必须修改）
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ─────────────────────────────────────────────────────────
# 告警配置
# ─────────────────────────────────────────────────────────

# Alertmanager Webhook URL
ALERTMANAGER_WEBHOOK_URL=http://host.docker.internal:5001/webhook

# Slack Webhook URL（可选）
SLACK_WEBHOOK_URL=

# 邮件 SMTP 配置（可选）
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM=alerts@example.com
EMAIL_TO=oncall@example.com

# ─────────────────────────────────────────────────────────
# 向量数据库配置 (Qdrant)
# ─────────────────────────────────────────────────────────

QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=

# ─────────────────────────────────────────────────────────
# 其他配置
# ─────────────────────────────────────────────────────────

# 最大并发工作线程数
MAX_CONCURRENT_WORKERS=3

# API 速率限制（每分钟请求数）
API_RATE_LIMIT_PER_MINUTE=60
